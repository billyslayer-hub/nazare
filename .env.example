# Copy to .env.local (or add in Vercel → Settings → Environment Variables). Never commit real keys.

# Turns on full AI: business plans, custom ad copy, open-ended Advisor chat and live web research.
# Without it Paideia runs in offline mode (Advisor and Ad Creator still work from your plan data).
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Only if your key is NOT inside a workspace (error mentions "anthropic-workspace-id"):
# the workspace ID from console.anthropic.com → Settings → Workspaces (starts with wrkspc_).
# ANTHROPIC_WORKSPACE_ID=

# Optional: Claude model. Default claude-sonnet-5-5 (fast, affordable).
# claude-haiku-5-5 = cheapest, claude-opus-5-5 = highest quality.
# PAIDEIA_MODEL=claude-sonnet-5-5

# Optional: set to "off" to disable live web research even when a key is present.
# PAIDEIA_WEB_RESEARCH=on

# Optional: per-IP requests per minute to the AI routes (default 150 — a class often shares one IP).
# PAIDEIA_RATE_LIMIT_PER_MIN=150
