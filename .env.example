# Copy to .env.local and fill in. Never commit real keys.

# Required for real AI generation, live web research and the Business Advisor.
# Without it the app runs in clearly labelled demo mode.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the Claude model (default: claude-opus-5-5).
# NAZARE_MODEL=claude-opus-5-5

# Optional: set to "off" to disable live web research even when a key is present.
# NAZARE_WEB_RESEARCH=on

# Optional: per-IP requests per minute to the AI routes (default 30).
# NAZARE_RATE_LIMIT_PER_MIN=30
